---
import { site } from '../config/site';
---

<section
  id="hero"
  class="relative min-h-[100svh] -mt-16 sm:-mt-20 pt-20 flex flex-col justify-center max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-line"
  aria-label="Introduction"
>
  <div class="py-12 sm:py-20 lg:py-28 flex flex-col justify-center">
    <!-- Top Monospace Label -->
    <div class="mb-6 sm:mb-8 flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-ink"></span>
      <span class="font-mono-tag text-xs uppercase tracking-widest text-ink-soft">
        [NEILIAN.DEV · DEVELOPER & DESIGNER]
      </span>
    </div>

    <!-- Fluid Headline with Reserved Height -->
    <h1
      class="text-ink font-extrabold tracking-tightest leading-[1.05] text-[clamp(2.25rem,6.8vw+0.8rem,7rem)] max-w-5xl"
      aria-label="I build systems that work."
    >
      <span class="block">I build systems</span>
      <span class="block text-ink-soft min-h-[1.15em] flex items-center flex-wrap" aria-hidden="true">
        <span>that&nbsp;</span>
        <span
          id="hero-typing-word"
          class="underline decoration-line decoration-2 underline-offset-8 text-ink inline-block"
        >work</span>
        <span
          id="hero-cursor"
          class="inline-block w-[3px] sm:w-[5px] h-[0.9em] ml-1 bg-ink align-middle animate-cursor-blink"
          aria-hidden="true"
        ></span>
      </span>
    </h1>

    <!-- Supporting Line -->
    <p class="mt-8 sm:mt-12 text-lg sm:text-2xl text-ink-soft max-w-2xl font-normal leading-relaxed">
      {site.description}
    </p>

    <!-- CTAs & Indicator -->
    <div class="mt-10 sm:mt-14 flex flex-wrap items-center gap-5 sm:gap-6">
      <a
        href="#work"
        class="inline-flex items-center justify-center px-6 py-3.5 bg-ink text-white font-medium text-sm tracking-wide rounded hover:bg-ink-soft transition-all duration-200 cursor-pointer min-h-[44px]"
      >
        <span>Explore Work</span>
        <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-6 py-3.5 border border-line text-ink font-medium text-sm tracking-wide rounded hover:border-ink transition-all duration-200 cursor-pointer min-h-[44px]"
      >
        <span>Get in touch</span>
      </a>
    </div>
  </div>

  <!-- Scroll prompt -->
  <div class="pb-8 hidden sm:flex items-center justify-between text-xs font-mono-tag text-ink-soft">
    <span>[SCROLL TO EXPLORE]</span>
    <span class="inline-block animate-bounce">↓</span>
  </div>
</section>

<style>
  @keyframes blink {
    0%, 49% {
      opacity: 1;
    }
    50%, 100% {
      opacity: 0;
    }
  }
  .animate-cursor-blink {
    animation: blink 0.9s infinite;
  }
</style>

<script>
  import { initHeroTyping } from '../scripts/typing';
  import { site } from '../config/site';

  function setupTyping() {
    const wordEl = document.getElementById('hero-typing-word');
    if (wordEl) {
      initHeroTyping({
        element: wordEl,
        words: site.heroWords,
        typeSpeed: 80,
        deleteSpeed: 45,
        holdTime: 1500,
        pauseTime: 300,
      });
    }
  }

  setupTyping();
  document.addEventListener('astro:page-load', setupTyping);
</script>
