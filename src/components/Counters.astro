---
import { site } from '../config/site';
---

<section
  id="counters"
  class="bg-ink text-white py-16 sm:py-24 border-y border-line"
  aria-label="Impact and Delivery Metrics"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-12">
      {
        site.counters.map((counter, idx) => (
          <div class="flex flex-col border-l border-white/20 pl-4 sm:pl-6">
            <span class="font-mono-tag text-xs text-white/50 mb-2">
              [0{idx + 1}]
            </span>
            <div class="text-4xl sm:text-6xl font-extrabold tracking-tightest tabular-nums text-white flex items-baseline">
              <span data-counter-target={counter.value}>
                {counter.value}
              </span>
              {counter.suffix && <span class="text-2xl sm:text-3xl ml-1 text-white/70">{counter.suffix}</span>}
            </div>
            <p class="mt-2 text-sm sm:text-base text-white/80 font-medium">
              {counter.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initCounters } from '../scripts/counters';

  initCounters();
  document.addEventListener('astro:page-load', initCounters);
</script>
