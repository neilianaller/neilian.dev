---
const services = [
  { text: 'information system', size: 'text-[clamp(1.25rem,3.8vw,3.5rem)]', weight: 'font-bold' },
  { text: 'mobile app', size: 'text-[clamp(2.2rem,6.6vw,6.0rem)]', weight: 'font-extrabold' },
  { text: 'web development', size: 'text-[clamp(1.45rem,4.6vw,4.1rem)]', weight: 'font-bold' },
  { text: 'automation', size: 'text-[clamp(2.2rem,6.6vw,6.0rem)]', weight: 'font-extrabold' },
  { text: 'programming', size: 'text-[clamp(2.0rem,6.0vw,5.5rem)]', weight: 'font-extrabold' },
  { text: 'custom software', size: 'text-[clamp(1.45rem,4.6vw,4.1rem)]', weight: 'font-bold' },
  { text: 'database management', size: 'text-[clamp(1.15rem,3.5vw,3.2rem)]', weight: 'font-bold' },
  { text: 'data privacy', size: 'text-[clamp(1.85rem,5.5vw,5.0rem)]', weight: 'font-extrabold' },
  { text: 'it services', size: 'text-[clamp(2.0rem,6.0vw,5.5rem)]', weight: 'font-extrabold' },
];
---

<section
  id="services"
  class="py-20 sm:py-28 lg:py-36 border-b border-line overflow-visible"
  aria-label="Services"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Label -->
    <div class="reveal-header mb-12 sm:mb-16">
      <div class="flex items-center gap-3">
        <span class="font-mono-tag text-xs font-semibold uppercase tracking-wider text-ink-soft">
          [01] SERVICES
        </span>
        <div class="h-[1px] flex-1 bg-line"></div>
      </div>
      <p class="mt-3 text-sm sm:text-base text-ink-soft font-mono-tag">
        Engineering resilient architectures, streamlined systems, and enduring digital craft.
      </p>
    </div>

    <!-- Mindmap-Style Typographic Stack -->
    <div class="w-full flex justify-center py-6 sm:py-10 overflow-visible">
      <ul
        id="services-list"
        class="services-group w-full max-w-4xl flex flex-col items-center justify-center text-center space-y-1 sm:space-y-2 list-none p-0 m-0 overflow-visible"
      >
        {
          services.map((item, idx) => (
            <li
              class={`service-item ${item.size} ${item.weight} text-ink tracking-tightest leading-[1.08] lowercase cursor-default select-none transition-all duration-300 ease-out will-change-transform transform-gpu`}
              data-index={idx}
            >
              <span class="inline-block transform-origin-center">
                {item.text}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Desktop Hover: all items fade slightly, hovered item scales up */
  @media (hover: hover) {
    .services-group:hover .service-item {
      opacity: 0.35;
    }
    .services-group .service-item:hover {
      opacity: 1 !important;
      transform: scale(1.12);
      z-index: 10;
    }
  }

  /* Touch / Scroll Center Detection Class */
  .service-item.is-in-view {
    opacity: 1 !important;
    transform: scale(1.08);
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .service-item {
      transition: none !important;
      transform: none !important;
    }
    .services-group:hover .service-item {
      opacity: 1 !important;
    }
  }
</style>

<script>
  function setupServicesTouchInteraction() {
    // Only engage scroll-based scaling on touch devices
    if (window.matchMedia('(hover: hover)').matches) return;

    const items = document.querySelectorAll<HTMLElement>('.service-item');
    if (!items.length) return;

    function checkActiveCenter() {
      const centerY = window.innerHeight / 2;
      let closestItem: HTMLElement | null = null;
      let minDistance = Infinity;

      items.forEach((item) => {
        const rect = item.getBoundingClientRect();
        const itemCenter = rect.top + rect.height / 2;
        const dist = Math.abs(centerY - itemCenter);

        if (dist < minDistance && rect.top < window.innerHeight && rect.bottom > 0) {
          minDistance = dist;
          closestItem = item;
        }
      });

      items.forEach((item) => {
        if (item === closestItem && minDistance < 140) {
          item.classList.add('is-in-view');
        } else {
          item.classList.remove('is-in-view');
        }
      });
    }

    window.addEventListener('scroll', checkActiveCenter, { passive: true });
    checkActiveCenter();
  }

  setupServicesTouchInteraction();
  document.addEventListener('astro:page-load', setupServicesTouchInteraction);
</script>
