---
interface Props {
  title: string;
  tagline: string;
  category: string;
  image: string;
  link: string;
  year?: number;
  featured?: boolean;
}

const {
  title,
  tagline,
  category,
  image,
  link,
  year = 2026,
} = Astro.props;
---

<article class="reveal-card group relative flex flex-col bg-white border border-line overflow-hidden transition-all duration-300 hover:border-ink">
  <!-- Square / Editorial Image Container -->
  <a
    href={link}
    target={link.startsWith('http') ? '_blank' : undefined}
    rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
    class="relative block aspect-square bg-surface overflow-hidden cursor-pointer"
    tabindex="-1"
    aria-hidden="true"
  >
    <img
      src={image}
      alt={`${title} graphic design preview`}
      loading="lazy"
      width="800"
      height="800"
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/5 transition-colors duration-300"></div>
    <div class="absolute top-3 left-3 font-mono-tag text-[11px] px-2.5 py-1 bg-white/90 backdrop-blur-sm border border-line text-ink">
      [{category}]
    </div>
    <div class="absolute bottom-3 right-3 font-mono-tag text-[11px] px-2.5 py-1 bg-white/90 backdrop-blur-sm border border-line text-ink">
      {year}
    </div>
  </a>

  <!-- Editorial Info -->
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-lg sm:text-xl font-bold text-ink tracking-tight">
        <a
          href={link}
          target={link.startsWith('http') ? '_blank' : undefined}
          rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="inline-flex items-center gap-1.5 group-hover:underline decoration-1 underline-offset-4 cursor-pointer"
        >
          <span>{title}</span>
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">
            →
          </span>
        </a>
      </h3>
      <p class="mt-2 text-xs sm:text-sm text-ink-soft line-clamp-2">
        {tagline}
      </p>
    </div>
  </div>
</article>
