---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section
  id="bir-registration"
  class={`bg-white py-14 sm:py-20 border-b border-line flex flex-col items-center justify-center ${className}`}
  aria-label="BIR Seal of Registration"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex flex-col items-center justify-center text-center">
    <div class="w-full max-w-[440px] sm:max-w-[560px] md:max-w-[620px] flex items-center justify-center">
      <img
        src="/placeholders/bir-seal.png"
        alt="Bureau of Internal Revenue (BIR) Seal of Registration"
        loading="lazy"
        width="1101"
        height="325"
        class="w-full h-auto object-contain mx-auto transition-opacity duration-300 hover:opacity-95"
      />
    </div>
  </div>
</section>
