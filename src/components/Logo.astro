---
interface Props {
  class?: string;
  inverted?: boolean;
}

const { class: className = '', inverted = false } = Astro.props;
---

<a
  href="/"
  class={`inline-flex items-center transition-opacity duration-200 hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink ${className}`}
  aria-label="NEILIAN.DEV - Home"
>
  <img
    src="/placeholders/neilian.dev-logo.png"
    alt="NEILIAN.DEV"
    width="1606"
    height="220"
    class={`h-7 sm:h-8 w-auto object-contain transition-all duration-200 ${
      inverted ? 'brightness-0 invert' : ''
    }`}
  />
</a>
