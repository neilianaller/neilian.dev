---
import Logo from './Logo.astro';
import SocialIcons from './SocialIcons.astro';
import { site } from '../config/site';

import { execSync } from 'node:child_process';

let latestCommit = '';
try {
  latestCommit =
    process.env.CF_PAGES_COMMIT_SHA?.slice(0, 7) ||
    process.env.GITHUB_SHA?.slice(0, 7) ||
    execSync('git rev-parse --short HEAD', { encoding: 'utf-8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
} catch {
  latestCommit = process.env.CF_PAGES_COMMIT_SHA?.slice(0, 7) || process.env.GITHUB_SHA?.slice(0, 7) || '';
}

const navLinks = [
  { label: 'SERVICES', href: '/#services', mono: '[01]' },
  { label: 'WORK', href: '/#work', mono: '[02]' },
  { label: 'DESIGN', href: '/#design', mono: '[03]' },
  { label: 'STORIES', href: '/stories', mono: '[04]' },
  { label: 'CONTACT', href: '/#contact', mono: '[05]' },
];
---

<footer class="bg-ink text-white border-t border-line py-16 sm:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 pb-16 border-b border-white/10">
      <!-- Col 1: Brand & Tagline -->
      <div class="md:col-span-5 flex flex-col justify-between space-y-6">
        <div>
          <Logo inverted={true} />
          <p class="mt-4 text-base sm:text-lg text-white/70 max-w-sm">
            {site.tagline}
          </p>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="md:col-span-3">
        <h3 class="font-mono-tag text-xs uppercase tracking-widest text-white/50 mb-4">
          INDEX
        </h3>
        <ul class="space-y-3 font-mono-tag text-xs">
          {
            navLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex items-center gap-2 text-white/80 hover:text-white transition-colors cursor-pointer"
                >
                  <span class="text-white/40">{item.mono}</span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Social Connections -->
      <div class="md:col-span-4 flex flex-col">
        <h3 class="font-mono-tag text-xs uppercase tracking-widest text-white/50 mb-4">
          CONNECT
        </h3>
        <p class="text-sm text-white/70 mb-6">
          Follow open-source releases, architectural write-ups, and brand design explorations.
        </p>
        <SocialIcons inverted={true} />
      </div>
    </div>

    <!-- Bottom Copyright & Meta Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono-tag text-xs text-white/40">
      <a
        href={latestCommit ? `https://github.com/neilianaller/neilian.dev/commit/${latestCommit}` : 'https://github.com/neilianaller/neilian.dev'}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors cursor-pointer group"
        title="View latest commit on GitHub"
      >
        <svg
          class="w-3.5 h-3.5 fill-current transition-transform duration-200 group-hover:scale-110"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        <span class="tracking-wider">{latestCommit || 'HEAD'}</span>
      </a>
      <div class="flex items-center gap-6">
        <a href="#hero" class="hover:text-white transition-colors cursor-pointer">BACK TO TOP ↑</a>
      </div>
    </div>
  </div>
</footer>
