---
interface Props {
  title: string;
  tagline: string;
  category: string;
  image: string;
  link: string;
  year?: number;
  storySlug?: string;
  priority?: boolean;
}

const {
  title,
  tagline,
  category,
  image,
  link,
  year = 2026,
  storySlug,
} = Astro.props;
---

<article class="reveal-card group flex flex-col bg-white border border-line rounded-none overflow-hidden transition-all duration-300 hover:border-ink">
  <!-- Image container (clipped 16:10 ratio) -->
  <a
    href={link}
    target={link.startsWith('http') ? '_blank' : undefined}
    rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
    class="relative block aspect-[16/10] bg-surface overflow-hidden cursor-pointer"
    tabindex="-1"
    aria-hidden="true"
  >
    <img
      src={image}
      alt={`${title} project preview`}
      loading="lazy"
      width="800"
      height="500"
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
    <div class="absolute top-3 right-3 font-mono-tag text-[11px] px-2.5 py-1 bg-white/90 backdrop-blur-sm border border-line text-ink">
      {year}
    </div>
  </a>

  <!-- Card Body -->
  <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between gap-4 mb-3">
        <span class="font-mono-tag text-xs font-medium uppercase tracking-wider text-ink-soft">
          [{category}]
        </span>
        {
          storySlug && (
            <a
              href={`/stories/${storySlug}`}
              class="font-mono-tag text-[11px] text-ink underline underline-offset-4 hover:opacity-75 cursor-pointer"
            >
              Why I Built →
            </a>
          )
        }
      </div>

      <h3 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
        <a
          href={link}
          target={link.startsWith('http') ? '_blank' : undefined}
          rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="inline-flex items-center gap-2 group-hover:underline decoration-1 underline-offset-4 cursor-pointer"
        >
          <span>{title}</span>
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-0.5">
            ↗
          </span>
        </a>
      </h3>

      <p class="mt-3 text-sm sm:text-base text-ink-soft line-clamp-2">
        {tagline}
      </p>
    </div>

    <!-- Live Link / Footer -->
    <div class="mt-6 pt-4 border-t border-line flex items-center justify-between text-xs font-mono-tag text-ink-soft">
      <span>LIVE SPECIFICATION</span>
      <a
        href={link}
        target={link.startsWith('http') ? '_blank' : undefined}
        rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="text-ink font-medium hover:underline cursor-pointer"
      >
        VISIT PROJECT →
      </a>
    </div>
  </div>
</article>
