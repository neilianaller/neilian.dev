---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const webProjects = await getCollection('web');
const sortedProjects = webProjects.sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Web Systems & Applications Archive — NEILIAN.DEV"
  description="Curated web development systems, interactive applications, and digital platforms by Neilian."
>
  <div class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb / Back Link -->
    <div class="mb-8">
      <a
        href="/"
        class="inline-flex items-center gap-2 font-mono-tag text-xs uppercase tracking-wider text-ink-soft hover:text-ink transition-colors cursor-pointer"
      >
        <span>← BACK TO OVERVIEW</span>
      </a>
    </div>

    <!-- Page Header -->
    <header class="reveal-header mb-12 sm:mb-16 border-b border-line pb-8">
      <div class="flex items-center gap-3">
        <span class="font-mono-tag text-xs font-semibold uppercase tracking-wider text-ink-soft">
          [GALLERY · 01]
        </span>
        <div class="h-[1px] w-12 bg-line"></div>
      </div>
      <h1 class="mt-4 text-4xl sm:text-6xl font-extrabold text-ink tracking-tightest">
        Web Development Archive
      </h1>
      <p class="mt-3 text-lg text-ink-soft max-w-2xl">
        High-performance web applications, robust backends, and static experiences crafted with modern standards.
      </p>
    </header>

    <!-- 3-Column Responsive Grid (1 col mobile, 2 tablet, 3 desktop) -->
    <div class="reveal-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            tagline={project.data.tagline}
            category={project.data.category}
            image={project.data.image}
            link={project.data.link}
            year={project.data.year}
            storySlug={project.data.storySlug}
          />
        ))
      }
    </div>

    <!-- Subtle NDA Disclaimer -->
    <div class="mt-16 sm:mt-20 pt-8 border-t border-line">
      <p class="font-mono-tag text-xs text-ink-soft leading-relaxed">
        <span class="text-ink font-semibold">[DISCLAIMER]</span> Some deployed web applications, enterprise systems, and client infrastructure are protected under Non-Disclosure Agreements (NDAs) and cannot be publicly showcased.
      </p>
    </div>
  </div>
</Base>
